{
  "name": "mischief",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20.18.1",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "pnpm pdf-worker && pnpm docs && pnpm registry:build && pnpm registry:smoke && pnpm package:build && next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "registry:build": "shadcn build",
    "registry:smoke": "shadcn add ./public/r/file-thumbnail.json --dry-run",
    "package:build": "pnpm --dir packages/mischief-ui build",
    "package:pack": "pnpm package:build && npm pack --dry-run ./packages/mischief-ui",
    "test": "vitest run",
    "check": "pnpm lockfile:check && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "lockfile:check": "pnpm install --frozen-lockfile --ignore-scripts --prefer-offline",
    "pdf-worker": "node scripts/copy-pdf-worker.mjs",
    "predev": "node scripts/copy-pdf-worker.mjs && tsx scripts/generate-docs.ts",
    "docs": "tsx scripts/generate-docs.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@next/third-parties": "^16.3.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.31.0",
    "motion": "^13.1.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.16.2",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^24.0.0",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.2",
    "eslint-config-next": "16.3.0",
    "jsdom": "^30.0.1",
    "mammoth": "^1.12.1",
    "papaparse": "^5.6.0",
    "pdfjs-dist": "^6.2.108",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.5.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.120.1"
  }
}
